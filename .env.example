BOT_TOKEN=Insert:token

# Pixiv PHPSESSID — enables full-resolution and R-18 downloads.
# Leave empty for public illustrations only.
PIXIV_COOKIE=

# Where downloaded media is stored before sending (tmpfs in Docker).
DOWNLOAD_DIR=tmp

# Max video size in MB; larger videos are compressed with ffmpeg.
MAX_FILE_SIZE_MB=50

# Answer Bot API 10 guest messages — links sent in chats the bot doesn't
# belong to. Set to false to keep the bot silent outside its own chats.
GUEST_MODE=true
